# Build-time (CI only). The Claude Code CLI uses this to execute prose programs.
ANTHROPIC_API_KEY=

# Public PostHog ingestion keys; values are supplied separately at build time.
# Missing/unknown environment disables analytics. Production also requires
# the exact https://docs.prose.md origin; local tests must select staging.
NEXT_PUBLIC_POSTHOG_ENVIRONMENT=
NEXT_PUBLIC_POSTHOG_STAGING_KEY=
# Previous project token preserves its explicit opt-out; required for production.
NEXT_PUBLIC_POSTHOG_LEGACY_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Preview mode flag. When "true", robots.txt returns Disallow: /
# and every page emits <meta name="robots" content="noindex,nofollow">.
# Defaults to "true" so a forgotten flag never accidentally goes public.
DOCS_PREVIEW_MODE=true

# Cross-repo issue creation token used by program ② (drift guard).
# Lives only as a secret in the prose repo; not consumed by docs builds.
# Documented here as a reference for operators.
# OPENPROSE_DOCS_PAT=
